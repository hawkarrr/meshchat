<?xml version="1.0" encoding="utf-8"?>
<!--
  Chat history is stored on the phone without a layer of encryption of its own
  (it relies on the phone's lock screen and disk encryption), so it must not
  leave the phone through cloud backup or a device-to-device transfer. Keys live
  in the Android Keystore and cannot be backed up anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
